  },
  "assertions": [
    {
      "id": "runner-share-bounds-v1",
      "kind": "source-share-v1",
      "numeratorSources": ["runner"],
      "denominatorSources": ["runner", "choice", "callback", "settlement", "system"],
      "excludedSources": ["recovery"],
      "magnitude": "absolute-actual-post-clamp-delta",
      "sampleUnit": "one-complete-paired-run",
      "groupBy": ["startingProfileId", "difficulty", "choicePolicyId"],
      "reducer": "r7-median-of-per-run-ratios",
      "comparator": "inclusive-range",
      "lowerThresholdPath": "/metrics/attribution/runnerMedianMin",
      "upperThresholdPath": "/metrics/attribution/runnerMedianMax",
      "zeroDenominator": "fail-active-fixture"
    },
    {
      "id": "decision-share-minimum-v1",
      "kind": "source-share-v1",
      "numeratorSources": ["choice", "callback", "settlement"],
      "denominatorSources": ["runner", "choice", "callback", "settlement", "system"],
      "excludedSources": ["recovery"],
      "magnitude": "absolute-actual-post-clamp-delta-with-valid-choice-cause-for-callback-and-settlement",
      "sampleUnit": "one-complete-paired-run",
      "groupBy": ["startingProfileId", "difficulty", "choicePolicyId"],
      "reducer": "r7-median-of-per-run-ratios",
      "comparator": "greater-than-or-equal",
      "lowerThresholdPath": "/metrics/attribution/decisionMedianMin",
      "upperThresholdPath": null,
      "zeroDenominator": "fail-active-fixture"
    },
    {
      "id": "decision-influence-ratio-v1",
      "kind": "paired-distance-ratio-v1",
      "sampleUnit": "matched-seed-counterfactual-pair",
      "groupBy": ["startingProfileId", "difficulty"],
      "reducer": "r7-median-of-paired-normalized-score-distances",
      "comparator": "decision-greater-than-or-equal-multiple-of-runner",
      "lowerThresholdPath": "/metrics/decisionToRunnerDistanceRatioMin",
      "upperThresholdPath": null,
      "zeroDenominator": "runner-zero-decision-positive-passes-as-infinite-both-zero-fails"
    },
    {
      "id": "profile-distance-parity-v1",
      "kind": "paired-profile-distance-v1",
      "sampleUnit": "matched-seed-unordered-profile-pair",
      "groupBy": ["profilePair", "difficulty"],
      "reducer": "r7-median-of-paired-normalized-score-distances",
      "comparator": "less-than-or-equal",
      "lowerThresholdPath": null,
      "upperThresholdPath": "/metrics/startingProfileMedianDistanceMax",
      "zeroDenominator": "not-applicable"
    },
    {
      "id": "profile-route-coverage-parity-v1",
      "kind": "route-set-parity-v1",
      "sampleUnit": "complete-profile-cell",
      "groupBy": ["startingProfileId", "difficulty"],
      "reducer": "minimum-ending-and-repair-route-count",
      "comparator": "equal-across-all-profiles",
      "lowerThresholdPath": null,
      "upperThresholdPath": null,
      "zeroDenominator": "empty-route-set-fails"
    },
    {
      "id": "score-boundary-time-v1",
      "kind": "per-score-active-time-share-v1",
      "sampleUnit": "one-complete-paired-run-per-score",
      "groupBy": ["startingProfileId", "difficulty", "scoreId"],
      "reducer": "r7-median-of-per-run-active-tick-ratios",
      "comparator": "strictly-less-than",
      "lowerThresholdPath": null,
      "upperThresholdPath": "/metrics/boundaryActiveTimeMax",
      "zeroDenominator": "fail-active-fixture"
    },
    {
      "id": "choice-clamp-loss-v1",
      "kind": "whole-choice-clamp-loss-share-v1",
      "sampleUnit": "choice-with-any-requested-nonzero-score-component",
      "groupBy": ["startingProfileId", "difficulty"],
      "reducer": "affected-choices-divided-by-choices-with-any-requested-nonzero-component",
      "comparator": "strictly-less-than",
      "lowerThresholdPath": null,
      "upperThresholdPath": "/metrics/choiceClampLossMax",
      "zeroDenominator": "fail-active-fixture"
    },
    {
      "id": "semantic-assist-effect-identity-v1",
      "kind": "matched-trace-identity-v1",
      "sampleUnit": "matched-seed-stage-entry-and-lane-choice-trace",
      "groupBy": ["startingProfileId", "difficulty", "runSeed"],
      "reducer": "none-every-pair-must-pass",
      "comparator": "exactly-equal",
      "lowerThresholdPath": null,
      "upperThresholdPath": null,
      "zeroDenominator": "not-applicable"
    },
    {
      "id": "automatic-assist-score-parity-v1",
      "kind": "matched-trace-per-score-distance-v1",
      "sampleUnit": "matched-seed-and-stage-entry-neutral-trace",
      "groupBy": ["startingProfileId", "difficulty", "runSeed", "scoreId"],
      "reducer": "none-every-pair-must-pass",
      "comparator": "absolute-difference-less-than-or-equal",
      "lowerThresholdPath": null,
      "upperThresholdPath": "/metrics/assistPerScorePointTolerance",
      "zeroDenominator": "not-applicable"
    },
    {
      "id": "assist-narrative-parity-v1",
      "kind": "matched-trace-narrative-set-identity-v1",
      "sampleUnit": "matched-seed-and-stage-entry-neutral-trace",
      "groupBy": ["startingProfileId", "difficulty", "runSeed"],
      "reducer": "none-every-pair-must-pass",
      "comparator": "exactly-equal-fact-condition-callback-and-route-eligibility-sets",
      "lowerThresholdPath": null,
      "upperThresholdPath": null,
      "zeroDenominator": "not-applicable"
    }
  ],
