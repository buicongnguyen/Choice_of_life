{
  "$schema": "./fixture-registry-v1.schema.json",
  "schemaVersion": 1,
  "registryId": "choice-of-life-balance-v1",
  "status": "locked",
  "scoreOrder": ["health", "happiness", "money"],
  "seedSet": {
    "id": "balance-seeds-0-9999-v1",
    "kind": "inclusiveIntegerRange",
    "start": 0,
    "endInclusive": 9999,
    "step": 1,
    "runSeedEncoding": "lowercase-hex-16-zero-padded",
    "auditEncoding": "utf8-lines-lf-no-final-lf",
    "count": 10000,
    "firstEncodedSeed": "0000000000000000",
    "lastEncodedSeed": "000000000000270f",
    "expandedByteLength": 169999,
    "expandedSha256": "ef87ff82e9d189dbedc0e2bd7842bd3d0c31cc143539f3460e33efe80d063a97"
  },
  "difficulties": ["story", "normal", "challenge"],
  "pairingKeys": ["runSeed", "startingProfileId", "difficulty"],
  "statistics": {
    "quantileMethod": "r7-linear-interpolation",
    "aggregatePerDifficultyAndProfile": true,
    "poolDifficultyOrProfileCells": false
  },
  "metrics": {
    "normalizedScoreDistance": {
      "kind": "l1",
      "scoreOrder": ["health", "happiness", "money"],
      "denominator": 300,
      "range": [0, 1]
    },
    "appliedDeltaMagnitude": {
      "kind": "sum-absolute-post-clamp-deltas",
      "scoreOrder": ["health", "happiness", "money"]
    },
    "attribution": {
      "runnerSource": "runner",
      "decisionSources": ["choice", "callback", "settlement"],
      "decisionRequiresField": "causedByChoiceId",
      "missingCauseReclassifiedAs": "system",
      "excludedSources": ["recovery"],
      "eligibleDenominatorSources": ["runner", "choice", "callback", "settlement", "system"],
      "magnitudeBasis": "absolute-actual-post-clamp-delta",
      "calculationOrder": "per-run-ratio-then-r7-median-per-profile-difficulty-choice-policy-cell",
      "zeroDenominator": "fixture-failure",
      "runnerMedianMin": {"numerator": 1, "denominator": 4},
      "runnerMedianMax": {"numerator": 7, "denominator": 20},
      "runnerBoundsInclusive": true,
      "decisionMedianMin": {"numerator": 13, "denominator": 20},
      "decisionMinimumInclusive": true
    },
    "decisionToRunnerDistanceRatioMin": {"numerator": 2, "denominator": 1},
    "decisionToRunnerDistanceRatioInclusive": true,
    "boundaryActiveTimeMax": {"numerator": 1, "denominator": 10},
    "boundaryActiveTimeMaximumInclusive": false,
    "choiceClampLossMax": {"numerator": 1, "denominator": 20},
    "choiceClampLossMaximumInclusive": false,
    "choiceClampLossUnit": "choice-with-any-requested-nonzero-score-component-whose-actual-delta-is-zero",
    "startingProfileMedianDistanceMax": {"numerator": 2, "denominator": 25},
    "startingProfileMedianDistanceMaximumInclusive": true,
    "assistPerScorePointTolerance": 3
  },
  "numericGoals": [
    {
      "id": "health-first-v1",
      "weights": {"numerators": [3, 1, 1], "denominator": 5}
    },
    {
      "id": "happiness-first-v1",
      "weights": {"numerators": [1, 3, 1], "denominator": 5}
    },
    {
      "id": "security-first-v1",
      "weights": {"numerators": [1, 1, 3], "denominator": 5}
    },
    {
      "id": "balanced-v1",
