{
  "name": "choice-of-life",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Choice of Life — a three-score side-scrolling life runner where every decision shapes the future.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/buicongnguyen/Choice_of_life.git",
    "full_name": "buicongnguyen/Choice_of_life"
  },
  "scripts": {
    "dev": "vite",
    "release:stamp": "node scripts/write-release.mjs",
    "release:verify": "node scripts/check-release.mjs",
    "build": "tsc && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "boundaries": "node scripts/check-choice-boundaries.mjs",
    "fixtures:validate": "node scripts/validate-fixture-locks.mjs",
    "fixtures:preregister": "node scripts/validate-fixture-preregistration.mjs",
    "fixtures:validate-preregistration": "node scripts/validate-committed-fixture-preregistration.mjs",
    "verify": "npm run check && npm run check:core && npm run boundaries && npm run fixtures:validate && npm test && npm run build && npm run release:verify && npm run budget",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:core": "tsc -p tsconfig.choice-of-life-core.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
