{
  "name": "choice-of-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Choice of Life — a three-score side-scrolling life runner where every decision shapes the future.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/buicongnguyen/Choice_of_life.git",
    "full_name": "buicongnguyen/Choice_of_life"
  },
  "scripts": {
    "dev": "vite",
    "generate:training": "node scripts/generate-training-questions.mjs",
    "release:stamp": "node scripts/write-release.mjs",
    "release:verify": "node scripts/check-release.mjs",
    "build": "tsc && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "verify": "npm run check && npm test && npm run build && npm run release:verify && npm run budget",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "vite": "^7.0.0"
  }
}
